+/// The wait before the next frame. Any event resets it to the minimum, then it
+/// doubles each quiet frame up to a ceiling: short while something animates,
+/// long in low power mode, [`LOOP_MAX_TIMEOUT_MS`] otherwise.
+fn next_timeout(current_ms: u32, event: bool, animating: bool, low_power: bool) -> u32 {
+    if event {
+        return LOOP_TIMEOUT_MIN_MS;
+    }
+    let ceiling = if animating {
+        LOOP_MAX_TIMEOUT_FRAME_ACTIVE_MS
+    } else if low_power {
+        LOOP_MAX_TIMEOUT_LOWPOWER_MS
+    } else {
+        LOOP_MAX_TIMEOUT_MS
+    };
+    (current_ms.min(ceiling) * 2).clamp(LOOP_TIMEOUT_MIN_MS, ceiling)
+}
+
+/// Keeps the input tap subscribed to plain mouse movement only while the
