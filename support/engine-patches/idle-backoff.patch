+#[cfg(test)]
+mod timeout_tests {
+    use super::*;
+
+    #[test]
+    fn an_event_resets_the_wait_from_any_level() {
+        for current in [1, 37, 500, 2000] {
+            assert_eq!(next_timeout(current, true, false, false), 1);
+            assert_eq!(next_timeout(current, true, true, true), 1);
+        }
+    }
+
+    #[test]
+    fn quiet_frames_double_until_the_ceiling() {
+        let mut wait = 1;
+        let mut seen = vec![wait];
+        for _ in 0..12 {
+            wait = next_timeout(wait, false, false, false);
+            seen.push(wait);
+        }
+        assert_eq!(seen, [1, 2, 4, 8, 16, 32, 64, 128, 256, 500, 500, 500, 500]);
+    }
+
+    #[test]
+    fn animation_keeps_frames_at_full_rate() {
+        let mut wait = 1;
+        for _ in 0..10 {
+            wait = next_timeout(wait, false, true, false);
+            assert!(wait <= LOOP_MAX_TIMEOUT_FRAME_ACTIVE_MS);
+        }
+        assert_eq!(wait, LOOP_MAX_TIMEOUT_FRAME_ACTIVE_MS);
+        // An animation starting after a long idle pulls the wait straight down.
+        assert_eq!(
+            next_timeout(500, false, true, false),
+            LOOP_MAX_TIMEOUT_FRAME_ACTIVE_MS
+        );
+    }
+
+    #[test]
+    fn low_power_mode_raises_the_ceiling() {
+        assert_eq!(next_timeout(500, false, false, true), 1000);
+        assert_eq!(next_timeout(2000, false, false, true), 2000);
+        assert_eq!(next_timeout(2000, false, true, true), 16);
+    }
+
+    #[test]
+    fn an_idle_minute_runs_the_schedule_about_a_hundred_and_thirty_times() {
+        let (mut wait, mut elapsed_ms, mut runs) = (1, 0, 0);
+        while elapsed_ms < 60_000 {
+            elapsed_ms += u64::from(wait);
+            runs += 1;
+            wait = next_timeout(wait, false, false, false);
+        }
+        assert!((120..=135).contains(&runs), "{runs} runs in a minute");
+    }
+}
