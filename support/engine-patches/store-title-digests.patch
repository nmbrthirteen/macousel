+
+/// The state file outlives the session, so it keeps a digest of each window
+/// title instead of the title. FNV-1a stays stable across Rust releases.
+pub(crate) fn title_digest(title: &str) -> String {
+    if title.is_empty() {
+        return String::new();
+    }
+    let hash = title.bytes().fold(0xcbf2_9ce4_8422_2325_u64, |hash, byte| {
+        (hash ^ u64::from(byte)).wrapping_mul(0x0000_0100_0000_01b3)
+    });
+    format!("{hash:016x}")
 }
 
