+/// Parks a floating window in the bottom-right corner of `display_bounds`, where
+/// a hidden virtual workspace parks its strip, and remembers where it was.
+pub(crate) fn park_float(
+    entity: Entity,
+    parked_for: ParkedFor,
+    display_bounds: IRect,
+    windows: &Windows,
+    commands: &mut Commands,
+) {
+    let Some(frame) = windows.moving_frame(entity) else {
+        return;
+    };
+    if let Ok(mut entity_commands) = commands.get_entity(entity) {
+        entity_commands.try_insert(ParkedFloat {
+            origin: frame.min,
+            parked_for,
+        });
+    }
+    commands.reposition_entity(entity, display_bounds.max - PARKED_STRIP_SLIVER);
+}
+
+/// Brings a parked floating window back to where it was parked from.
+pub(crate) fn unpark_float(entity: Entity, parked: &ParkedFloat, commands: &mut Commands) {
+    if let Ok(mut entity_commands) = commands.get_entity(entity) {
+        entity_commands.try_remove::<ParkedFloat>();
+    }
+    commands.reposition_entity(entity, parked.origin);
+}
+
+/// Floating windows belong to the virtual workspace they were showing on. A
+/// switch parks the ones of the row being left and brings back the ones of the
+/// row being shown. Pinned windows are left where they are, which is what keeps
+/// them on screen across the switch.
+#[allow(clippy::too_many_arguments)]
+#[instrument(level = Level::DEBUG, skip_all)]
+fn park_floats_with_their_row(
+    activated: Single<(&LayoutStrip, &ChildOf), Added<ActiveWorkspaceMarker>>,
+    strips: Query<&LayoutStrip>,
+    displays: Query<&Display>,
+    windows: Windows,
+    window_manager: Res<WindowManager>,
+    config: Res<Config>,
+    mut shown_rows: Local<HashMap<WorkspaceId, u32>>,
+    mut commands: Commands,
+) {
+    let (strip, child) = *activated;
+    let workspace_id = strip.id();
+    let shown = ParkedFor::Row {
+        workspace_id,
+        virtual_index: strip.virtual_index,
+    };
+    for (entity, parked) in windows.parked_iter() {
+        if parked.parked_for == shown {
+            unpark_float(entity, parked, &mut commands);
+        }
+    }
+
+    let Some(left_index) = shown_rows
+        .insert(workspace_id, strip.virtual_index)
+        .filter(|left_index| *left_index != strip.virtual_index)
+    else {
+        return;
+    };
+    // `reap_empty_virtual_workspaces` despawns a row left without tiled
+    // windows on the same switch, so its floating windows come along instead
+    // of waiting for a row that is gone.
+    let Some(left_strip) = strips
+        .iter()
+        .find(|left| left.id() == workspace_id && left.virtual_index == left_index)
+    else {
+        return;
+    };
+    if config.reap_empty_workspaces() && left_index > 0 && left_strip.len() == 0 {
+        return;
+    }
+    let Ok(display) = displays.get(child.parent()) else {
+        return;
+    };
+
+    let bounds = display.bounds();
+    let on_space = window_manager
+        .windows_in_workspace(workspace_id)
+        .unwrap_or_default();
+    let left = ParkedFor::Row {
+        workspace_id,
+        virtual_index: left_index,
+    };
+    for (window, entity) in windows.iter() {
+        let floating = windows
+            .get_managed(entity)
+            .is_some_and(|(_, _, unmanaged)| matches!(unmanaged, Some(Unmanaged::Floating)));
+        let on_display = windows
+            .frame(entity)
+            .is_some_and(|frame| !frame.intersect(bounds).is_empty());
+        if floating
+            && on_display
+            && on_space.contains(&window.id())
+            && !windows.pinned(entity)
+            && windows.parked(entity).is_none()
+        {
+            park_float(entity, left, bounds, &windows, &mut commands);
+        }
+    }
+}
+
+/// A parked floating window can still take focus, from Cmd-Tab or its Dock
+/// icon. It comes back together with whatever it was parked with. This reads
+/// the focus events rather than the focus marker, because a float that keeps
+/// focus while its row is switched away never gains the marker again.
+#[instrument(level = Level::DEBUG, skip_all)]
+fn unpark_focused_float(
+    mut messages: MessageReader<Event>,
+    strips: Query<(Entity, &LayoutStrip)>,
+    windows: Windows,
+    mut commands: Commands,
+) {
+    let Some(parked) = messages
+        .read()
+        .filter_map(|event| match event {
+            Event::WindowFocused { window_id } => windows.find(*window_id),
+            _ => None,
+        })
+        .last()
+        .and_then(|(_, entity)| windows.parked(entity))
+    else {
+        return;
+    };
+    let row_strip = match parked.parked_for {
+        ParkedFor::Row {
+            workspace_id,
+            virtual_index,
+        } => strips.iter().find_map(|(entity, strip)| {
+            (strip.id() == workspace_id && strip.virtual_index == virtual_index).then_some(entity)
+        }),
+        ParkedFor::PinLayer => None,
+    };
+    if let Some(row_strip) = row_strip
+        && let Ok(mut entity_commands) = commands.get_entity(row_strip)
+    {
+        entity_commands.try_insert(ActiveWorkspaceMarker);
+        return;
+    }
+    let parked_for = parked.parked_for;
+    for (entity, parked) in windows.parked_iter() {
+        if parked.parked_for == parked_for {
+            unpark_float(entity, parked, &mut commands);
+        }
+    }
+}
+
+/// Brings back the floating windows parked for a row that is going away.
+fn unpark_floats_of_removed_row(
+    trigger: On<Remove, LayoutStrip>,
+    strips: Query<&LayoutStrip>,
+    windows: Windows,
+    mut commands: Commands,
+) {
+    let Ok(strip) = strips.get(trigger.entity) else {
+        return;
+    };
+    let row = ParkedFor::Row {
+        workspace_id: strip.id(),
+        virtual_index: strip.virtual_index,
+    };
+    for (entity, parked) in windows.parked_iter() {
+        if parked.parked_for == row {
+            unpark_float(entity, parked, &mut commands);
+        }
+    }
+}
+
+/// Pinning and parking only mean something for a floating window.
+fn forget_pin_of_tiled_window(trigger: On<Remove, Unmanaged>, mut commands: Commands) {
+    if let Ok(mut entity_commands) = commands.get_entity(trigger.entity) {
+        entity_commands.try_remove::<(Pinned, ParkedFloat)>();
+    }
+}
