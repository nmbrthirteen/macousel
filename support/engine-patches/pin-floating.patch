+/// Pins the focused window, floating it first when it is tiled, or unpins a
+/// pinned one, which stays floating.
+fn pin_window(mut messages: MessageReader<Event>, windows: Windows, mut commands: Commands) {
+    if filter_window_operations(&mut messages, |op| matches!(op, Operation::Pin))
+        .next()
+        .is_none()
+    {
+        return;
+    }
+
+    let Some((_, entity, unmanaged)) = windows
+        .focused()
+        .and_then(|(_, entity)| windows.get_managed(entity))
+    else {
+        return;
+    };
+    let pinned = windows.pinned(entity);
+    let pinnable = matches!(unmanaged, None | Some(Unmanaged::Floating));
+    let Ok(mut entity_commands) = commands.get_entity(entity) else {
+        return;
+    };
+    if pinned {
+        entity_commands.try_remove::<Pinned>();
+    } else if pinnable {
+        entity_commands.try_insert((Unmanaged::Floating, Pinned));
+    }
+}
+
+/// Parks every pinned window at the corner of the display it is on, or brings
+/// them all back when they are parked.
+fn toggle_pin_layer(
+    mut messages: MessageReader<Event>,
+    windows: Windows,
+    displays: Query<&Display>,
+    active_display: ActiveDisplay,
+    mut commands: Commands,
+) {
+    if filter_window_operations(&mut messages, |op| matches!(op, Operation::PinLayer))
+        .next()
+        .is_none()
+    {
+        return;
+    }
+
+    if windows
+        .parked_iter()
+        .any(|(_, parked)| parked.parked_for == ParkedFor::PinLayer)
+    {
+        for (entity, parked) in windows.parked_iter() {
+            if parked.parked_for == ParkedFor::PinLayer {
+                unpark_float(entity, parked, &mut commands);
+            }
+        }
+        return;
+    }
+
+    let pinned = windows
+        .iter()
+        .map(|(_, entity)| entity)
+        .filter(|entity| {
+            windows.pinned(*entity)
+                && windows.parked(*entity).is_none()
+                && windows
+                    .get_managed(*entity)
+                    .is_some_and(|(_, _, unmanaged)| matches!(unmanaged, Some(Unmanaged::Floating)))
+        })
+        .collect::<Vec<_>>();
+    for &entity in &pinned {
+        let Some(frame) = windows.frame(entity) else {
+            continue;
+        };
+        let bounds = displays
+            .iter()
+            .map(Display::bounds)
+            .map(|bounds| {
+                let overlap = bounds.intersect(frame);
+                let area = i64::from(overlap.width().max(0)) * i64::from(overlap.height().max(0));
+                (bounds, area)
+            })
+            .filter(|(_, area)| *area > 0)
+            .max_by_key(|(_, area)| *area)
+            .map_or_else(|| active_display.bounds(), |(bounds, _)| bounds);
+        park_float(entity, ParkedFor::PinLayer, bounds, &windows, &mut commands);
+    }
+
+    // Keyboard focus must not stay on a window that just left the screen.
+    if windows
+        .focused()
+        .is_some_and(|(_, entity)| pinned.contains(&entity))
+    {
+        commands.trigger(SendMessageTrigger(Event::Command {
+            command: Command::Window(Operation::FocusManaged),
+        }));
+    }
+}
