+//! Tests for `Operation::Pin` and `Operation::PinLayer`, and for floating
+//! windows staying with their virtual workspace while pinned ones stay on
+//! screen across a switch.
+
+use std::cell::Cell;
+use std::rc::Rc;
+
+use bevy::ecs::system::SystemState;
+use bevy::prelude::*;
+
+use crate::commands::{Command, Operation};
+use crate::ecs::layout::LayoutStrip;
+use crate::ecs::state::{PaneruQueryState, QueryStateParams};
+use crate::ecs::{ActiveWorkspaceMarker, ParkedFloat, ParkedFor, Pinned, Unmanaged};
+use crate::events::Event;
+use crate::manager::{Origin, Window};
+use crate::platform::WinID;
+use crate::types::windowset::WindowSet;
+use crate::{assert_focused, assert_window_at};
+
+use super::*;
+
+const PARKED_X: i32 = TEST_DISPLAY_WIDTH - 10;
+const PARKED_Y: i32 = TEST_DISPLAY_HEIGHT - 10;
+
+fn command(operation: Operation) -> Event {
+    Event::Command {
+        command: Command::Window(operation),
+    }
+}
+
+fn is_pinned(world: &mut World, window_id: WinID) -> bool {
+    let entity = find_window_entity(window_id, world);
+    world.get::<Pinned>(entity).is_some()
+}
+
+fn is_floating(world: &mut World, window_id: WinID) -> bool {
+    let entity = find_window_entity(window_id, world);
+    matches!(world.get::<Unmanaged>(entity), Some(Unmanaged::Floating))
+}
+
+fn parked_for(world: &mut World, window_id: WinID) -> Option<ParkedFor> {
+    let entity = find_window_entity(window_id, world);
+    world
+        .get::<ParkedFloat>(entity)
+        .map(|parked| parked.parked_for)
+}
+
+fn origin_of(world: &mut World, window_id: WinID) -> Origin {
+    let mut query = world.query::<&Window>();
+    query
+        .iter(world)
+        .find(|window| window.id() == window_id)
+        .expect("window not found")
+        .frame()
+        .min
+}
+
+fn in_any_strip(world: &mut World, window_id: WinID) -> bool {
+    let entity = find_window_entity(window_id, world);
+    let mut query = world.query::<&LayoutStrip>();
+    query.iter(world).any(|strip| strip.contains(entity))
+}
+
+fn snapshot(world: &mut World) -> (PaneruQueryState, WindowSet) {
+    let mut system_state: SystemState<QueryStateParams> = SystemState::new(world);
+    let params = system_state.get(world).expect("state params");
+    (
+        params.extract().expect("query state"),
+        params.extract_window_set().expect("window set"),
+    )
+}
+
+#[test]
+fn test_pin_floats_a_tiled_window_and_unpinning_keeps_it_floating() {
+    let commands = vec![
+        Event::WindowFocused { window_id: 0 },
+        command(Operation::Pin),
+        command(Operation::Pin),
+    ];
+
+    TestHarness::new()
+        .with_windows(2)
+        .on_iteration(1, |world, _state| {
+            assert!(is_pinned(world, 0));
+            assert!(is_floating(world, 0));
+            assert!(
+                !in_any_strip(world, 0),
+                "a pinned window leaves the strip like any floating window"
+            );
+        })
+        .on_iteration(2, |world, _state| {
+            assert!(!is_pinned(world, 0));
+            assert!(is_floating(world, 0), "unpinning must not tile the window");
+        })
+        .run(commands);
+}
+
+#[test]
+fn test_retiling_a_pinned_window_unpins_it() {
+    let commands = vec![
+        Event::WindowFocused { window_id: 0 },
+        command(Operation::Pin),
+        command(Operation::Manage),
+    ];
+
+    TestHarness::new()
+        .with_windows(2)
+        .on_iteration(2, |world, _state| {
+            assert!(!is_floating(world, 0));
+            assert!(!is_pinned(world, 0));
+            assert!(in_any_strip(world, 0));
+        })
+        .run(commands);
+}
+
+#[test]
+fn test_virtual_switch_parks_floats_and_keeps_pinned_windows_on_screen() {
+    let pinned_origin = Rc::new(Cell::new(Origin::ZERO));
+    let floating_origin = Rc::new(Cell::new(Origin::ZERO));
+    let commands = vec![
+        Event::WindowFocused { window_id: 0 },
+        command(Operation::Pin),
+        Event::Command {
+            command: Command::PrintState,
+        },
+        command(Operation::Manage),
+        command(Operation::VirtualNumber(1)),
+        command(Operation::VirtualNumber(0)),
+    ];
+
+    let (pinned_before, floating_before) = (pinned_origin.clone(), floating_origin.clone());
+    let (pinned_after, floating_after) = (pinned_origin, floating_origin);
+    TestHarness::new()
+        .with_windows(3)
+        .on_iteration(1, |_world, state| state.focus_window(1))
+        .on_iteration(3, move |world, _state| {
+            pinned_before.set(origin_of(world, 0));
+            floating_before.set(origin_of(world, 1));
+        })
+        .on_iteration(4, move |world, _state| {
+            assert_eq!(parked_for(world, 0), None);
+            assert_eq!(origin_of(world, 0), pinned_after.get());
+            assert_eq!(
+                parked_for(world, 1),
+                Some(ParkedFor::Row {
+                    workspace_id: TEST_WORKSPACE_ID,
+                    virtual_index: 0,
+                })
+            );
+            assert_window_at!(world, 1, PARKED_X, PARKED_Y);
+        })
+        .on_iteration(5, move |world, _state| {
+            assert_eq!(parked_for(world, 1), None);
+            assert_eq!(origin_of(world, 1), floating_after.get());
+        })
+        .run(commands);
+}
+
+#[test]
+fn test_focusing_a_float_parked_with_its_row_shows_the_row() {
+    let commands = vec![
+        Event::WindowFocused { window_id: 0 },
+        command(Operation::Manage),
+        command(Operation::VirtualNumber(1)),
+        Event::Command {
+            command: Command::PrintState,
+        },
+    ];
+
+    TestHarness::new()
+        .with_windows(2)
+        .on_iteration(2, |world, state| {
+            assert!(parked_for(world, 0).is_some());
+            state.focus_window(0);
+        })
+        .on_iteration(3, |world, _state| {
+            let mut query = world.query_filtered::<&LayoutStrip, With<ActiveWorkspaceMarker>>();
+            let active = query.single(world).expect("an active strip");
+            assert_eq!(active.virtual_index, 0);
+            assert_eq!(parked_for(world, 0), None);
+            assert_focused!(world, 0);
+        })
+        .run(commands);
+}
+
+#[test]
+fn test_pin_layer_parks_pinned_windows_and_brings_them_back() {
+    let origin = Rc::new(Cell::new(Origin::ZERO));
+    let commands = vec![
+        Event::WindowFocused { window_id: 0 },
+        command(Operation::Pin),
+        command(Operation::PinLayer),
+        command(Operation::PinLayer),
+    ];
+
+    let (before, after) = (origin.clone(), origin);
+    TestHarness::new()
+        .with_windows(2)
+        .on_iteration(1, move |world, _state| {
+            before.set(origin_of(world, 0));
+        })
+        .on_iteration(2, |world, _state| {
+            assert_eq!(parked_for(world, 0), Some(ParkedFor::PinLayer));
+            assert_window_at!(world, 0, PARKED_X, PARKED_Y);
+            assert_focused!(world, 1);
+        })
+        .on_iteration(3, move |world, _state| {
+            assert_eq!(parked_for(world, 0), None);
+            assert_eq!(origin_of(world, 0), after.get());
+            assert!(is_pinned(world, 0));
+        })
+        .run(commands);
+}
+
+#[test]
+fn test_state_reports_pinned_and_parked_windows() {
+    let commands = vec![
+        Event::WindowFocused { window_id: 0 },
+        command(Operation::Pin),
+        Event::Command {
+            command: Command::PrintState,
+        },
+        command(Operation::Manage),
+        command(Operation::VirtualNumber(1)),
+    ];
+
+    TestHarness::new()
+        .with_windows(3)
+        .on_iteration(1, |_world, state| state.focus_window(1))
+        .on_iteration(4, |world, _state| {
+            let (state, set) = snapshot(world);
+            let row = |number: u32| {
+                state
+                    .virtual_workspaces
+                    .iter()
+                    .find(|workspace| workspace.number == number)
+                    .expect("the row")
+            };
+
+            let shown = row(2);
+            assert!(shown.active);
+            let pinned = shown
+                .windows
+                .iter()
+                .find(|window| window.window_id == 0)
+                .expect("the pinned window shows on the new row");
+            assert!(pinned.pinned);
+            assert!(pinned.visible);
+            assert!(shown.windows.iter().all(|window| window.window_id != 1));
+
+            let left = row(1);
+            let parked = left
+                .windows
+                .iter()
+                .find(|window| window.window_id == 1)
+                .expect("the parked float stays listed with its row");
+            assert!(!parked.pinned);
+            assert!(!parked.visible);
+
+            let floating = set
+                .current()
+                .expect("an active workspace")
+                .floating
+                .iter()
+                .map(|window| (window.id, window.pinned))
+                .collect::<Vec<_>>();
+            assert_eq!(floating, vec![(0, true)]);
+        })
+        .run(commands);
+}
