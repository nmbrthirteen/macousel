+    /// Regression: a browser floated its own tiled window once raising its
+    /// picture-in-picture player made the app report the player as focused.
+    #[test]
+    fn focus_landing_on_a_floating_sibling_is_not_a_rejection() {
+        let mut world = World::new();
+        let app = spawn_app(&mut world, true, 2);
+        let target = spawn_window(&mut world, app, 1);
+        let player = spawn_window(&mut world, app, 2);
+        world.entity_mut(player).insert((
+            Position(bevy::math::IVec2::new(800, 0)),
+            Unmanaged::Floating,
+        ));
+
+        let mut strip = LayoutStrip::default();
+        strip.append(target);
+        world.spawn(strip);
+
+        world
+            .entity_mut(target)
+            .insert((FocusedMarker, VerifyFocus, expired_verify_timeout()));
+
+        let system_id = world.register_system(detect_focus_rejection);
+        _ = world.run_system(system_id);
+
+        assert!(world.get::<Unmanaged>(target).is_none());
+        let mut strips = world.query::<&LayoutStrip>();
+        assert!(strips.single(&world).expect("one strip").contains(target));
     }
 
     #[test]
