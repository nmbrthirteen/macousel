 /// Runs the Bevy schedule loop with each tick wrapped in an Objective-C
 /// `NSAutoreleasePool`.
 ///
+/// Bevy sizes its pools to the CPU core count, which gave a window manager two
+/// dozen mostly idle threads. Async compute keeps a few threads so the startup
+/// window scans of several apps still overlap. Compute runs the `par_iter_mut`
+/// that moves and resizes windows. Each move blocks on the window's app, so the
+/// pool needs a thread per window on screen, or a strip lands in waves.
+fn small_task_pools() -> TaskPoolOptions {
+    let defaults = TaskPoolOptions::default();
+    TaskPoolOptions {
+        async_compute: TaskPoolThreadAssignmentPolicy {
+            max_threads: 3,
+            ..defaults.async_compute
+        },
+        // Bevy caps compute at the free core count, so the floor is what sets it.
+        compute: TaskPoolThreadAssignmentPolicy {
+            min_threads: 12,
+            max_threads: 12,
+            ..defaults.compute
+        },
+        ..defaults
+    }
+}
+
