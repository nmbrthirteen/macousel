+/// A column's place in its strip: its x before the strip offset, its width, and
+/// the horizontal padding its windows carry.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct ColumnSpan {
+    pub x: i32,
+    pub width: i32,
+    pub h_pad: i32,
+}
+
+/// The strip offset that keeps a column from resting across an edge shared with
+/// another display. A column [`peek_for`] would slide in has to overlap its
+/// neighbour, so the strip moves just far enough to hide it instead, and the
+/// next column starts flush with the shared edge. Only a move that keeps the
+/// strip covering the opposite edge counts, so it never opens an empty band.
+pub(crate) fn snap_to_shared_edge(
+    columns: &[ColumnSpan],
+    offset: i32,
+    viewport: IRect,
+    display: IRect,
+    adjacency: Adjacency,
+) -> Option<i32> {
+    let (first, last) = (columns.first()?, columns.last()?);
+    for (index, column) in columns.iter().enumerate() {
+        let min_x = column.x + offset;
+        let frame = IRect::new(min_x, viewport.min.y, min_x + column.width, viewport.max.y);
+        let Some(peek) = peek_for(frame, viewport, display, column.h_pad, adjacency) else {
+            continue;
+        };
+        let snapped = if peek > min_x {
+            let next = columns.get(index + 1)?;
+            let snapped = viewport.min.x - next.x;
+            (last.x + last.width + snapped >= viewport.max.x).then_some(snapped)
+        } else {
+            let previous = columns.get(index.checked_sub(1)?)?;
+            let snapped = viewport.max.x - (previous.x + previous.width);
+            (first.x + snapped <= viewport.min.x).then_some(snapped)
+        };
+        return snapped.filter(|snapped| *snapped != offset);
+    }
+    None
+}
