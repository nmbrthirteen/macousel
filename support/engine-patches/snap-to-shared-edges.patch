+/// A column that would rest mostly past an edge shared with another display
+/// used to slide back over its neighbour. The strip now scrolls it off instead,
+/// so the windows left on screen sit side by side.
+#[test]
+fn test_column_across_shared_edge_scrolls_off_instead_of_overlapping() {
+    fn assert_no_overlap(world: &mut World) {
+        let mut query = world.query::<&Window>();
+        let shown = query
+            .iter(world)
+            .map(|window| (window.id(), window.frame()))
+            .filter(|(_, frame)| frame.max.x.min(TEST_DISPLAY_WIDTH) - frame.min.x.max(0) > 10)
+            .collect::<Vec<_>>();
+        for (index, (id, frame)) in shown.iter().enumerate() {
+            for (other_id, other) in &shown[index + 1..] {
+                assert!(
+                    frame.max.x <= other.min.x || other.max.x <= frame.min.x,
+                    "window {id} at {frame:?} overlaps window {other_id} at {other:?}"
+                );
+            }
+        }
+    }
+
+    let focus = |direction| Event::Command {
+        command: Command::Window(Operation::Focus(direction)),
+    };
+    let mut commands = vec![Event::MenuOpened { window_id: 0 }];
+    commands.extend((0..4).map(|_| focus(Direction::East)));
+    commands.extend((0..3).map(|_| focus(Direction::West)));
+
+    TestHarness::new()
+        .with_window(0, |_| {})
+        .with_window(1, |_| {})
+        .with_window(2, |_| {})
+        .with_window(3, |window| window.frame.max.x = window.frame.min.x + 700)
+        .with_window(4, |_| {})
+        .with_display(
+            EXT_DISPLAY_ID,
+            IRect::new(
+                TEST_DISPLAY_WIDTH,
+                0,
+                TEST_DISPLAY_WIDTH + EXT_DISPLAY_WIDTH,
+                EXT_DISPLAY_HEIGHT,
+            ),
+            vec![EXT_WORKSPACE_ID],
+        )
+        .on_iteration(7, |world, _state| {
+            crate::assert_focused!(world, 1);
+            assert_no_overlap(world);
+        })
+        .run(commands);
+}
