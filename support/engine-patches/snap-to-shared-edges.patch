+/// Moves a strip that is about to rest with a column across an edge shared
+/// with another display, see [`snap_to_shared_edge`]. It checks a strip when it
+/// gets a new scroll target, when its columns change, and when a swipe ends.
+#[allow(clippy::type_complexity)]
+#[instrument(level = Level::DEBUG, skip_all)]
+fn snap_strips_to_shared_edges(
+    strips: Query<
+        (
+            Entity,
+            Ref<LayoutStrip>,
+            &Position,
+            &ChildOf,
+            Option<Ref<RepositionMarker>>,
+            Ref<ActiveWorkspaceMarker>,
+        ),
+        Without<Scrolling>,
+    >,
+    mut swipes_ended: RemovedComponents<Scrolling>,
+    displays: DisplayViewports,
+    windows: Windows,
+    config: Res<Config>,
+    mut commands: Commands,
+) {
+    let swipes_ended = swipes_ended.read().collect::<EntityHashSet>();
+    for (strip_entity, strip, position, child, reposition, active) in &strips {
+        let target = reposition.as_ref().map_or(position.0, |marker| marker.0);
+        if active.is_added()
+            || !(strip.is_changed()
+                || reposition.is_some_and(|marker| marker.is_changed())
+                || swipes_ended.contains(&strip_entity))
+        {
+            continue;
+        }
+        let Ok((display, dock)) = displays.get(child.parent()) else {
+            continue;
+        };
+        let columns = strip
+            .columns()
+            .map(|column| {
+                let top = column.top()?;
+                let x = windows.layout_position(top)?.0.x;
+                let width = windows.moving_frame(top)?.width();
+                let h_pad = windows.get(top)?.horizontal_padding();
+                Some(ColumnSpan { x, width, h_pad })
+            })
+            .collect::<Option<Vec<_>>>();
+        let Some(columns) = columns else {
+            continue;
+        };
+        let adjacency = Adjacency::of(
+            display.bounds(),
+            displays.iter().map(|(other, _)| other.bounds()),
+        );
+        let viewport = display.actual_display_bounds(dock, &config);
+        if let Some(x) =
+            snap_to_shared_edge(&columns, target.x, viewport, display.bounds(), adjacency)
+        {
+            trace!("snap_strips_to_shared_edges: strip {strip_entity} to x {x}");
+            commands.reposition_entity(strip_entity, target.with_x(x));
+        }
+    }
+}
