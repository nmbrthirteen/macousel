 pub(super) fn commit_window_position(
     mut moved_windows: Populated<(&mut Window, &Position), Changed<Position>>,
+    displays: Query<&Display>,
 ) {
-    // `par_iter_mut` runs on `ComputeTaskPool` worker threads, which have no
-    // `CFRunLoop` of their own to drain thread-local autorelease pools.
-    moved_windows
-        .par_iter_mut()
-        .for_each(|(mut window, position)| {
-            objc2::rc::autoreleasepool(|_| window.reposition(position.0));
-        });
+    let screens = displays.iter().map(Display::bounds).collect::<Vec<_>>();
+    let mut moves = moved_windows
+        .iter_mut()
+        .map(|(window, position)| Some((window, position.0)))
+        .collect::<Vec<_>>();
+    let plan = moves
+        .iter()
+        .flatten()
+        .map(|(window, origin)| (window.frame(), *origin))
+        .collect::<Vec<_>>();
+    for wave in move_waves(&plan, &screens) {
+        let batch = wave
+            .into_iter()
+            .filter_map(|index| moves[index].take())
+            .collect::<Vec<_>>();
+        // Worker threads have no `CFRunLoop` of their own to drain
+        // thread-local autorelease pools, hence the explicit pool.
+        let reposition = |(mut window, origin): (Mut<Window>, Origin)| {
+            objc2::rc::autoreleasepool(|_| window.reposition(origin));
+        };
+        match bevy::tasks::ComputeTaskPool::try_get() {
+            Some(pool) if batch.len() > 1 => {
+                pool.scope(|scope| {
+                    for item in batch {
+                        scope.spawn(async move { reposition(item) });
+                    }
+                });
+            }
+            _ => batch.into_iter().for_each(reposition),
+        }
+    }
 }
 
