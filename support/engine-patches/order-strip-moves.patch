+/// How far into a display a window has to reach to count as visible. A window
+/// parked off screen keeps a sliver a few pixels wide, which does not count.
+const VISIBLE_REACH: i32 = 32;
+
+/// Groups window moves into waves that run one after another, so a spot on
+/// screen is covered before the window on it leaves.
+///
+/// Every app moves its own window, and they finish at different times. Moving
+/// all of them at once left gaps that showed the wallpaper for a frame or two.
+/// The first wave holds every window arriving on screen and every window that
+/// stays off screen, and runs in parallel. Then each window already on screen
+/// moves alone, starting from the back of the motion: when the strip shifts
+/// left, the rightmost window goes first and slides over its neighbour's spot
+/// before that neighbour leaves. A brief overlap replaces the gap. Windows
+/// stacked in one column share a wave.
+fn move_waves(moves: &[(IRect, Origin)], screens: &[IRect]) -> Vec<Vec<usize>> {
+    let visible = |frame: IRect| {
+        screens.iter().any(|screen| {
+            let shared = screen.intersect(frame);
+            shared.width() >= VISIBLE_REACH && shared.height() > 0
+        })
+    };
+    let mut first = Vec::new();
+    let mut leaving = Vec::new();
+    for (index, (frame, _)) in moves.iter().enumerate() {
+        if visible(*frame) {
+            leaving.push(index);
+        } else {
+            first.push(index);
+        }
+    }
+    let shift: i64 = leaving
+        .iter()
+        .map(|&index| i64::from(moves[index].1.x - moves[index].0.min.x))
+        .sum();
+    if shift < 0 {
+        leaving.sort_by_key(|&index| std::cmp::Reverse(moves[index].0.min.x));
+    } else {
+        leaving.sort_by_key(|&index| moves[index].0.min.x);
+    }
+    let mut waves = Vec::with_capacity(leaving.len() + 1);
+    if !first.is_empty() {
+        waves.push(first);
+    }
+    // Windows stacked in one column share an edge and move together.
+    waves.extend(
+        leaving
+            .chunk_by(|&a, &b| moves[a].0.min.x == moves[b].0.min.x)
+            .map(<[usize]>::to_vec),
+    );
+    waves
+}
