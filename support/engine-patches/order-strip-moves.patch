+#[cfg(test)]
+mod move_wave_tests {
+    use super::move_waves;
+    use bevy::math::{IRect, IVec2};
+
+    const SCREEN: IRect = IRect {
+        min: IVec2::new(0, 0),
+        max: IVec2::new(1000, 800),
+    };
+
+    fn half(x: i32) -> IRect {
+        IRect::new(x, 0, x + 500, 800)
+    }
+
+    #[test]
+    fn shifting_left_moves_the_arriving_window_then_right_to_left() {
+        let moves = [
+            (half(0), IVec2::new(-495, 0)),
+            (half(500), IVec2::new(0, 0)),
+            (half(995), IVec2::new(500, 0)),
+        ];
+        assert_eq!(move_waves(&moves, &[SCREEN]), vec![vec![2], vec![1], vec![0]]);
+    }
+
+    #[test]
+    fn shifting_right_moves_left_to_right() {
+        let moves = [
+            (half(500), IVec2::new(995, 0)),
+            (half(0), IVec2::new(500, 0)),
+            (half(-495), IVec2::new(0, 0)),
+        ];
+        assert_eq!(move_waves(&moves, &[SCREEN]), vec![vec![2], vec![1], vec![0]]);
+    }
+
+    #[test]
+    fn windows_off_screen_move_together_in_the_first_wave() {
+        let moves = [
+            (half(-495), IVec2::new(-490, 0)),
+            (half(2000), IVec2::new(1995, 0)),
+            (half(-495), IVec2::new(0, 0)),
+        ];
+        assert_eq!(move_waves(&moves, &[SCREEN]), vec![vec![0, 1, 2]]);
+    }
+
+    #[test]
+    fn a_stacked_column_moves_in_one_wave() {
+        let top = IRect::new(500, 0, 1000, 400);
+        let bottom = IRect::new(500, 400, 1000, 800);
+        let moves = [
+            (half(0), IVec2::new(-495, 0)),
+            (top, IVec2::new(0, 0)),
+            (bottom, IVec2::new(0, 400)),
+        ];
+        assert_eq!(move_waves(&moves, &[SCREEN]), vec![vec![1, 2], vec![0]]);
+    }
+
+    #[test]
+    fn a_window_on_another_display_counts_as_visible() {
+        let other = IRect::new(1000, 0, 2000, 800);
+        let moves = [(half(1200), IVec2::new(1100, 0))];
+        assert_eq!(move_waves(&moves, &[SCREEN, other]), vec![vec![0]]);
+    }
+}
