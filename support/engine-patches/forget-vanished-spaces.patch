+/// Drops empty strips whose space macOS no longer lists. A missed `SpaceDestroyed`
+/// otherwise leaves a strip that every state read trips over.
+#[instrument(level = Level::DEBUG, skip_all)]
+fn prune_vanished_workspaces(
+    mut messages: MessageReader<Event>,
+    workspaces: Query<(&LayoutStrip, Entity, Has<ActiveWorkspaceMarker>)>,
+    displays: Query<&Display>,
+    window_manager: Res<WindowManager>,
+    mut commands: Commands,
+) {
+    if !messages
+        .read()
+        .any(|event| matches!(event, Event::SpaceChanged))
+    {
+        return;
+    }
+    let present = window_manager.present_displays();
+    // A display whose spaces could not be read would make all of its spaces look gone.
+    if present.len() < displays.iter().count() {
+        return;
+    }
+    let live: HashSet<WorkspaceId> = present
+        .into_iter()
+        .flat_map(|(_, spaces)| spaces)
+        .collect();
+    for (strip, entity, active) in &workspaces {
+        if active || strip.len() > 0 || strip.is_fullscreen() || live.contains(&strip.id()) {
+            continue;
+        }
+        debug!("despawning strip for vanished space {}", strip.id());
+        if let Ok(mut entity_commands) = commands.get_entity(entity) {
+            entity_commands.try_despawn();
+        }
+    }
+}
