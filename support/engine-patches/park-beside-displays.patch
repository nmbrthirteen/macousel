 /// frame has left the display entirely to whichever display it landed on.
 pub(crate) const PARKED_STRIP_SLIVER: i32 = 10;
 
+/// How far short of its midpoint a window may hang over an edge shared with
+/// another display. macOS hands a window to the display holding most of it, so
+/// a window has to leave such an edge before it is half way across.
+const ADOPTION_MARGIN: i32 = 16;
+
+/// Marks a window parked away from the side it scrolled off, because another
+/// display sits on that side.
+#[derive(Component)]
+pub(crate) struct ParkedAcrossMarker;
+
+/// Which sides of a display touch another display.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct Adjacency {
+    pub left: bool,
+    pub right: bool,
+}
+
+impl Adjacency {
+    pub(crate) fn of(bounds: IRect, others: impl IntoIterator<Item = IRect>) -> Self {
+        let reach = Origin::new(bounds.width(), 0);
+        let left = IRect::from_corners(bounds.min - reach, bounds.max - reach);
+        let right = IRect::from_corners(bounds.min + reach, bounds.max + reach);
+        others
+            .into_iter()
+            .filter(|other| *other != bounds)
+            .fold(Self::default(), |sides, other| Self {
+                left: sides.left || !other.intersect(left).is_empty(),
+                right: sides.right || !other.intersect(right).is_empty(),
+            })
+    }
+}
+
+/// Where a window that does not fit the viewport waits.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Park {
+    Left,
+    Right,
+    Below,
+}
+
+/// Picks the side a window is hidden on, and where it parks, given its strip
+/// frame. A side shared with another display hides the window once most of it
+/// would cross, and parks it on a side that touches no display.
+pub(crate) fn park_for(
+    frame: IRect,
+    viewport: IRect,
+    display: IRect,
+    h_pad: i32,
+    adjacency: Adjacency,
+) -> Option<(Park, Park)> {
+    let middle = frame.min.x + frame.width() / 2;
+    let hidden = if frame.max.x <= viewport.min.x + h_pad
+        || adjacency.left && middle < display.min.x + ADOPTION_MARGIN
+    {
+        Park::Left
+    } else if frame.min.x >= viewport.max.x - h_pad
+        || adjacency.right && middle > display.max.x - ADOPTION_MARGIN
+    {
+        Park::Right
+    } else {
+        return None;
+    };
+    let park = match (hidden, adjacency.left, adjacency.right) {
+        (_, true, true) => Park::Below,
+        (Park::Left, true, false) => Park::Right,
+        (Park::Right, false, true) => Park::Left,
+        _ => hidden,
+    };
+    Some((hidden, park))
+}
