+/// macOS hands a window to the display holding most of it. With a display to
+/// the right, the windows scrolled off that side must wait on the free side.
+#[test]
+fn test_hidden_windows_stay_off_the_display_beside() {
+    fn assert_all_on_main_display(world: &mut World) {
+        let mut query = world.query::<&Window>();
+        for window in query.iter(world) {
+            let frame = window.frame();
+            let middle = frame.min.x + frame.width() / 2;
+            assert!(
+                middle < TEST_DISPLAY_WIDTH,
+                "window {} at {:?} sits mostly on the display beside",
+                window.id(),
+                frame
+            );
+        }
+    }
+
+    let commands = vec![
+        Event::MenuOpened { window_id: 0 },
+        Event::Command {
+            command: Command::Window(Operation::Focus(Direction::First)),
+        },
+        Event::Command {
+            command: Command::Window(Operation::Focus(Direction::Last)),
+        },
+        Event::Command {
+            command: Command::Window(Operation::Focus(Direction::First)),
+        },
+    ];
+
+    TestHarness::new()
+        .with_windows(5)
+        .with_display(
+            EXT_DISPLAY_ID,
+            IRect::new(
+                TEST_DISPLAY_WIDTH,
+                0,
+                TEST_DISPLAY_WIDTH + EXT_DISPLAY_WIDTH,
+                EXT_DISPLAY_HEIGHT,
+            ),
+            vec![EXT_WORKSPACE_ID],
+        )
+        .on_iteration(2, |world, _state| assert_all_on_main_display(world))
+        .on_iteration(3, |world, _state| assert_all_on_main_display(world))
+        .on_iteration(4, |world, _state| assert_all_on_main_display(world))
+        .run(commands);
+}
