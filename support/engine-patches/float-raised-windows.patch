+/// A picture-in-picture player sits above the normal window level with a
+/// standard subrole, so only its level says it should not be tiled.
+#[test]
+fn window_above_normal_level_floats() {
+    TestHarness::new()
+        .with_window(0, |window| window.above_normal_level = true)
+        .with_window(1, |_| {})
+        .on_iteration(0, |world, _state| {
+            let raised = find_window_entity(0, world);
+            let normal = find_window_entity(1, world);
+            assert!(matches!(
+                world.get::<Unmanaged>(raised),
+                Some(Unmanaged::Floating)
+            ));
+            assert!(world.get::<Unmanaged>(normal).is_none());
+            let mut strips = world.query::<&LayoutStrip>();
+            assert!(strips.iter(world).all(|strip| !strip.contains(raised)));
+            assert!(strips.iter(world).any(|strip| strip.contains(normal)));
+        })
+        .run(vec![Event::MenuOpened { window_id: 1 }]);
+}
