+
+#[cfg(test)]
+mod overflow_tests {
+    use super::needs_centering;
+
+    const SCREEN: (i32, i32) = (0, 1000);
+
+    #[test]
+    fn a_window_on_screen_stays_put() {
+        assert!(!needs_centering((500, 1000), Some((0, 500)), SCREEN));
+        assert!(!needs_centering((0, 1000), None, SCREEN));
+    }
+
+    #[test]
+    fn a_half_beside_a_half_scrolls_to_the_edge() {
+        assert!(!needs_centering((1000, 1500), Some((500, 1000)), SCREEN));
+        assert!(!needs_centering((-500, 0), Some((0, 500)), SCREEN));
+    }
+
+    #[test]
+    fn a_window_that_cannot_share_the_screen_is_centered() {
+        assert!(needs_centering((1000, 1750), Some((250, 1000)), SCREEN));
+        assert!(needs_centering((-800, -50), Some((-50, 600)), SCREEN));
+    }
+
+    #[test]
+    fn a_window_wider_than_the_screen_is_centered() {
+        assert!(needs_centering((900, 2100), None, SCREEN));
+    }
+}
