+/// `true` when the focused window, at its place in the strip, is cut off by the
+/// viewport and does not fit on screen beside the neighbour on the side facing
+/// the screen. Scrolling it to the edge would then cut that neighbour off, so
+/// the window is centered instead. Reads the strip's target offset, because a
+/// window scrolled off screen is parked as a sliver and its frame says nothing
+/// about where the strip holds it.
+fn overflows_beside_neighbour(
+    entity: Entity,
+    strip: &LayoutStrip,
+    strip_entity: Entity,
+    windows: &Windows,
+    strips: &Query<(&Position, Option<&RepositionMarker>), With<LayoutStrip>>,
+    viewport: IRect,
+) -> bool {
+    let Ok((position, reposition)) = strips.get(strip_entity) else {
+        return false;
+    };
+    let offset = reposition.map_or(position.0, |reposition| reposition.0);
+    let span = |entity: Entity| -> Option<(i32, i32)> {
+        let min = windows.layout_position(entity)?.0.x + offset.x;
+        Some((min, min + windows.moving_frame(entity)?.width()))
+    };
+    let Some(focused) = span(entity) else {
+        return false;
+    };
+    let neighbour = if focused.1 > viewport.max.x {
+        strip.left_neighbour(entity)
+    } else {
+        strip.right_neighbour(entity)
+    };
+    needs_centering(focused, neighbour.and_then(span), (viewport.min.x, viewport.max.x))
+}
+
+/// The decision behind [`overflows_beside_neighbour`], on horizontal spans.
+fn needs_centering(focused: (i32, i32), neighbour: Option<(i32, i32)>, viewport: (i32, i32)) -> bool {
+    if focused.0 >= viewport.0 && focused.1 <= viewport.1 {
+        return false;
+    }
+    let neighbour_width = neighbour.map_or(0, |(min, max)| max - min);
+    (focused.1 - focused.0) + neighbour_width > viewport.1 - viewport.0
+}
