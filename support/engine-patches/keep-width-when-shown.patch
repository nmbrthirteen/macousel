diff --git a/src/tests/interaction.rs b/src/tests/interaction.rs
index 8e551a0..c16ce84 100644
--- a/src/tests/interaction.rs
+++ b/src/tests/interaction.rs
@@ -3420,3 +3420,65 @@ fn test_virtual_move_number_recreates_missing_baseline_row() {
         "the moved window should land on a single recreated row 0"
     );
