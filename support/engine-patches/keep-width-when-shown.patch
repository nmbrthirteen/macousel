+
+/// A width the user set survives the app hiding and showing its window. The
+/// catch-all width rule is only the starting width, so bringing the window
+/// back must not apply it again.
+#[test]
+fn test_hidden_window_keeps_its_width_when_shown_again() {
+    let config = Config::try_from(
+        r#"
+[options]
+
+[windows.all]
+title = ".*"
+width = 0.5
+
+[bindings]
+"#,
+    )
+    .expect("config should parse");
+    let commands = vec![
+        Event::WindowFocused { window_id: 0 },
+        Event::Command {
+            command: Command::Window(Operation::SetWidth(0.25)),
+        },
+        Event::Command {
+            command: Command::PrintState,
+        },
+        Event::ApplicationHidden {
+            pid: TEST_PROCESS_ID,
+        },
+        Event::Command {
+            command: Command::PrintState,
+        },
+        Event::ApplicationVisible {
+            pid: TEST_PROCESS_ID,
+        },
+        Event::WindowFocused { window_id: 0 },
+        Event::Command {
+            command: Command::PrintState,
+        },
+    ];
+    let width_of = |world: &mut World| {
+        let mut query = world.query::<&Window>();
+        let window = query.iter(world).find(|w| w.id() == 0).expect("window 0");
+        window.frame().width()
+    };
+
+    TestHarness::new()
+        .with_config(config)
+        .with_windows(1)
+        .on_iteration(2, move |world, _state| {
+            assert_eq!(width_of(world), TEST_DISPLAY_WIDTH / 4);
+        })
+        .on_iteration(4, |world, _state| {
+            let mut query = world.query::<(&Window, Option<&crate::ecs::Unmanaged>)>();
+            let (_, unmanaged) = query.iter(world).find(|(w, _)| w.id() == 0).expect("window 0");
+            assert!(matches!(unmanaged, Some(crate::ecs::Unmanaged::Hidden)));
+        })
+        .on_iteration(7, move |world, _state| {
+            assert_eq!(width_of(world), TEST_DISPLAY_WIDTH / 4);
+        })
+        .run(commands);
+}
